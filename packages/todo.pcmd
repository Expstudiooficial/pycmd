# todo: a to-do list that remembers itself between runs
# version: 1.0
use fs
use json

struct Todo {
    file: str = "todo.json"
    items: list = []
    fn load(self) {
        if fs.exists(self.file) { self.items = json.parse(fs.read(self.file)) }
        return self
    }
    fn save(self) { fs.write(self.file, json.stringify(self.items)) }
    fn add(self, text: str) {
        self.items.push({"text": text, "done": false})
        self.save()
    }
    fn done(self, n: int) {
        self.items[n - 1]["done"] = true
        self.save()
    }
    fn clear_done(self) {
        self.items = self.items.filter(|i| not i["done"])
        self.save()
    }
    fn show(self) {
        if self.items.is_empty() { return "nothing to do" }
        return "\n".join([(i + 1, item) for i, item in enumerate(self.items)]
            .map(|p| "{p[0]}. [{p[1]["done"] ? "x" : " "}] {p[1]["text"]}"))
    }
}

fn open(file: str = "todo.json") => Todo(file).load()

test "todo" {
    let t = open("todo-test.json")
    t.add("write code")
    t.add("test it")
    t.done(1)
    assert str(t) == "1. [x] write code\n2. [ ] test it"
    t.clear_done()
    assert t.items.len() == 1
    fs.remove("todo-test.json")
}

# life: Conway's Game of Life
# version: 1.0

fn step(alive) {
    let counts = {}
    for cell in alive {
        let (x, y) = cell
        for dx in -1..=1 {
            for dy in -1..=1 {
                if dx != 0 or dy != 0 {
                    let n = (x + dx, y + dy)
                    counts[n] = counts.get(n, 0) + 1
                }
            }
        }
    }
    return set([c for c, n in counts if n == 3 or (n == 2 and alive.has(c))])
}

fn run(alive, generations: int) {
    var now = alive
    for _ in 0..generations { now = step(now) }
    return now
}

fn draw(alive, w: int, h: int) => "\n".join(["".join([alive.has((x, y)) ? "#" : "." for x in 0..w]) for y in 0..h])

let glider = set([(1, 0), (2, 1), (0, 2), (1, 2), (2, 2)])
let blinker = set([(0, 1), (1, 1), (2, 1)])

test "life" {
    assert run(blinker, 2) == blinker
    assert run(glider, 4) == set(glider.map(|c| (c[0] + 1, c[1] + 1)))
}

# fraction: exact fractions like 1/3 that never round
# version: 1.0
use math

struct Frac {
    n: int
    d: int = 1
    fn plus(self, o) => make(self.n * o.d + o.n * self.d, self.d * o.d)
    fn minus(self, o) => make(self.n * o.d - o.n * self.d, self.d * o.d)
    fn times(self, o) => make(self.n * o.n, self.d * o.d)
    fn div(self, o) => make(self.n * o.d, self.d * o.n)
    fn compare(self, o) => self.n * o.d - o.n * self.d
    fn equals(self, o) => self.n * o.d == o.n * self.d
    fn to_float(self) => self.n / self.d
    fn show(self) => self.d == 1 ? str(self.n) : "{self.n}/{self.d}"
}

fn make(n: int, d: int) -> Frac {
    if d == 0 { throw Error("a fraction cannot have 0 below the line", "Math") }
    let g = math.gcd(n, d)
    let s = d < 0 ? -1 : 1
    return Frac(s * n // g, s * d // g)
}

fn frac(n, d = 1) => make(n, d)

test "fractions add exactly" {
    assert frac(1, 3) + frac(1, 6) == frac(1, 2)
    assert str(frac(2, 4)) == "1/2"
    assert str(frac(3, 1)) == "3"
    assert frac(1, 2) < frac(2, 3)
}

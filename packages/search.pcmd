# search: linear and binary search
# version: 1.0

fn linear(xs, target) {
    for i, x in enumerate(xs) {
        if x == target { return i }
    }
    return -1
}

fn binary(xs, target) {
    var lo = 0
    var hi = xs.len() - 1
    while lo <= hi {
        let mid = (lo + hi) // 2
        if xs[mid] == target { return mid }
        if xs[mid] < target { lo = mid + 1 } else { hi = mid - 1 }
    }
    return -1
}

fn steps_binary(n: int) {
    var steps = 0
    var size = n
    while size > 0 {
        size = size // 2
        steps += 1
    }
    return steps
}

test "search" {
    assert linear([4, 8, 15], 15) == 2
    assert binary([1, 3, 5, 7, 9, 11], 9) == 4
    assert binary([1, 3], 2) == -1
    assert steps_binary(1000) == 10
}

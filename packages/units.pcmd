# units: convert temperature, length, weight and speed
# version: 1.0

fn c_to_f(c) => c * 9 / 5 + 32
fn f_to_c(f) => (f - 32) * 5 / 9
fn c_to_k(c) => c + 273.15

let LENGTH = {"mm": 0.001, "cm": 0.01, "m": 1, "km": 1000, "in": 0.0254, "ft": 0.3048, "mi": 1609.344}
let WEIGHT = {"g": 0.001, "kg": 1, "lb": 0.45359237, "oz": 0.028349523125}

fn convert(value, from: str, to: str) {
    for table in [LENGTH, WEIGHT] {
        if table.has(from) and table.has(to) {
            return value * table[from] / table[to]
        }
    }
    throw Error("cannot convert {from} to {to}", "Units")
}

fn kmh_to_ms(v) => v / 3.6

test "conversions" {
    assert c_to_f(100) == 212.0
    assert f_to_c(32) == 0.0
    assert convert(1, "km", "m") == 1000.0
    assert round(convert(1, "mi", "km"), 3) == 1.609
}

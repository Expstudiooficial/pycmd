# bst: a binary search tree - insert, find, sorted order, height
# version: 1.0

struct TreeNode {
    key: any
    left: any = nil
    right: any = nil
}

struct Tree {
    root: any = nil
    count: int = 0
    fn insert(self, key) {
        fn put(node) {
            if node == nil { return TreeNode(key) }
            if key < node.key { node.left = put(node.left) }
            elif key > node.key { node.right = put(node.right) }
            return node
        }
        self.root = put(self.root)
        self.count += 1
    }
    fn has(self, key) {
        var n = self.root
        while n != nil {
            if key == n.key { return true }
            n = key < n.key ? n.left : n.right
        }
        return false
    }
    fn sorted(self) {
        let out = []
        fn walk(n) {
            if n == nil { return }
            walk(n.left)
            out.push(n.key)
            walk(n.right)
        }
        walk(self.root)
        return out
    }
    fn height(self) {
        fn h(n) => n == nil ? 0 : 1 + max(h(n.left), h(n.right))
        return h(self.root)
    }
    fn min(self) {
        var n = self.root
        while n?.left != nil { n = n.left }
        return n?.key
    }
}

fn from_list(xs) {
    let t = Tree()
    for x in xs { t.insert(x) }
    return t
}

test "tree" {
    let t = from_list([5, 3, 8, 1, 4])
    assert t.sorted() == [1, 3, 4, 5, 8]
    assert t.has(4) and not t.has(7)
    assert t.height() == 3
    assert t.min() == 1
}

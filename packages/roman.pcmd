# roman: Roman numerals, both ways
# version: 1.0

let VALUES = [(1000, "M"), (900, "CM"), (500, "D"), (400, "CD"), (100, "C"), (90, "XC"),
    (50, "L"), (40, "XL"), (10, "X"), (9, "IX"), (5, "V"), (4, "IV"), (1, "I")]

fn to_roman(n: int) -> str {
    if n <= 0 or n >= 4000 { throw Error("Roman numerals go from 1 to 3999", "Value") }
    var left = n
    var out = ""
    for pair in VALUES {
        let (value, letters) = pair
        while left >= value {
            out += letters
            left -= value
        }
    }
    return out
}

fn from_roman(s: str) -> int {
    let one = {"I": 1, "V": 5, "X": 10, "L": 50, "C": 100, "D": 500, "M": 1000}
    var total = 0
    let up = s.upper()
    for i in 0..up.len() {
        let v = one[up[i]]
        let next = i + 1 < up.len() ? one[up[i + 1]] : 0
        total += v < next ? -v : v
    }
    return total
}

test "roman" {
    assert to_roman(1994) == "MCMXCIV"
    assert from_roman("mcmxciv") == 1994
    assert [to_roman(n) for n in 1..=5] == ["I", "II", "III", "IV", "V"]
}

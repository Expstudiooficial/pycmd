<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <!-- Music that keeps playing with the app closed, and its notification. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!--
      So a newer PyCmd can replace this one without uninstalling it first.
      Uninstalling is what deletes the workspace; installing over the top
      keeps every file. The user still confirms it in the system installer.
    -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <!-- The equaliser, bass boost, widener and reverb the DJ decks attach to
         their own audio sessions. Not a runtime permission; Android wants it
         declared before it hands out an AudioEffect. -->
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />

    <!--
      Since Android 11 an app cannot see what else is installed unless it says
      what it is looking for. Music Pro's "hand this search to another app"
      needs to know which apps answer the play-from-search intent, so that is
      exactly what is asked for - not a list of everything on the phone.
    -->
    <queries>
        <intent>
            <action android:name="android.media.action.MEDIA_PLAY_FROM_SEARCH" />
        </intent>
    </queries>

    <application
        android:name=".PyCmdApp"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:usesCleartextTraffic="true"
        android:theme="@style/Theme.PyCmd">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|uiMode"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.PyCmd">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Hands a downloaded APK to the system installer, and nothing else. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.updates"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <!--
          Declared so that Android will offer the notification-access switch,
          which is the only way to read the media sessions of other apps. The
          class overrides nothing: it never reads a notification. Nothing in
          PyCmd turns this on - the switch is in Android's own settings.
        -->
        <service
            android:name=".music.SessionAccess"
            android:exported="false"
            android:label="@string/session_access_label"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <service
            android:name=".python.ServerService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <!--
          The music player. Exported, and with that intent filter, because the
          system is what binds to it: the lock screen, the quick-settings media
          chip, a headset button and a car head unit all reach a media session
          through this, and a session nothing can bind to has none of them.
        -->
        <service
            android:name=".music.MusicService"
            android:exported="true"
            android:foregroundServiceType="mediaPlayback"
            tools:ignore="ExportedService">
            <intent-filter>
                <action android:name="androidx.media3.session.MediaSessionService" />
            </intent-filter>
        </service>

    </application>
</manifest>
